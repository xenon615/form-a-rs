{
    "def" : {
        "title": "Form1",
        "remoteSubmit" : true,
        "buttons" : [
            {
                "text" : "Save",
                "classes" : ["button", "button-primary","button-large"],
                "type" : "submit",
                "action": "submit"
            },
            {
                "text" : "Cancel",
                "classes" : ["button", "button-primary","button-large"],
                "type" : "button"
            }

        ],
        "fields" : [
            {
                "type":"repeater",
                "label":"Tasks",
                "name": "tasks",
                "fields": [
                    {
                        "type": "text",
                        "name": "task_name",
                        "label": "Task name"
                    },
                    {
                        "type": "radio",
                        "name": "priority",
                        "label": "Priority",
                        "default": "m",
                        "options": [
                            {"value":"h", "label": "High"},
                            {"value":"m", "label": "Medium"},
                            {"value":"l", "label": "Lazy"}
                        ]
                    }
                ]
            },
            {
                "type" : "text",
                "name" : "first_name",
                "label" : "First Name",
                "classes": ["is-cell", "cell-6"],
                "default": "Raymond",
                "cLogic": [
                    {
                        "path": "stuff--backup--where",
                        "value": "here",
                        "compare": "==",
                        "relation": "or"
                    }
                ]

            },
            {
                "type" : "text",
                "name" : "last_name",
                "label" : "Last Name"
            },

            {
                "type" : "radio",
                "name" : "sex",
                "label" : "Sex",
                "default": "f",
                "options": [
                    {"value":"m", "label": "Dude"},
                    {"value":"f", "label": "Girl"},
                    {"value":"c", "label": "Camel"}
                ]
            },
            {
                "type" : "textarea",
                "name" : "info",
                "label" : "Info",
                "rows" : 4

            },
            {
                "type" : "group",
                "name" : "stuff",
                "label" : "Stuff",
                "fields": [
                    {
                        "name": "name",
                        "type": "text",
                        "label": "Name"
                    },
                    {
                        "name": "color",
                        "type": "text",
                        "label": "Color",
                        "default": "marengo"
                    },

                    {
                        "name": "backup",
                        "type": "group",
                        "label": "Backup",
                        "fields": [
                            {
                                "name": "where",
                                "type": "select",
                                "label": "Where",
                                "default": "here",
                                "options": [
                                    {"value": "here", "label": "Here"},
                                    {"value": "there", "label": "There"}
                                ]
                            },
                            {
                                "name": "when",
                                "type": "text",
                                "label": "When"
                            },
                            {
                                "name": "is_done",
                                "type": "true-false",
                                "label": "Done?",
                                "default": true
                            },
                            {
                                "name": "desire",
                                "type": "checkbox",
                                "label": "What you want",
                                "default": "drink",
                                "options": [
                                    {"value": "eat", "label": "Eat"},
                                    {"value": "drink", "label": "Drink"},
                                    {"value": "sleep", "label": "Sleep"}
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "data" : {
        "first_name": "Ugon",
        "last_name": "Harleev",
        "info": "Some Text",
        "stuff": {
            "name": "Pope",
            "color": "red"
        }
        ,
        "tasks": [
            {"task_name" : "First"}
        ]
    }
}
