                "default": "Raymond",
                "cLogic": [
                    {
                        "path": "stuff--backup--where",
                        "value": "here",
                        "compare": "==",
                        "relation": "or"
                    }
                ]

            },
            {
                "type" : "text",
                "name" : "last_name",
                "label" : "Last Name"
            },

            {
                "type" : "radio",
                "name" : "sex",
                "label" : "Sex",
