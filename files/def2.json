{
    "def" : {
        "title": "Form1",
        "remoteSubmit" : true,
        "buttons" : [
            {
                "text" : "Save",
                "classes" : ["button", "button-primary","button-large"],
                "type" : "submit",
                "action": "submit"
            },
            {
                "text" : "Cancel",
                "classes" : ["button", "button-primary","button-large"],
                "type" : "button"
            }

        ],
        "fields" : [
            {
                "type" : "text",
                "name" : "first_name",
                "label" : "First Name",
