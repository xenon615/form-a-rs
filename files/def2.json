                "options": [
                    {"value":"m", "label": "Dude"},
                    {"value":"f", "label": "Girl"},
                    {"value":"c", "label": "Camel"}
                ]
            },
            {
                "type" : "textarea",
                "name" : "info",
                "label" : "Info",
                "rows" : 4

            },
            {
                "type" : "group",
                "name" : "stuff",
                "label" : "Stuff",
                "fields": [
                    {
                        "name": "name",
                        "type": "text",
                        "label": "Name"
                    },
                    {
                        "name": "color",
                        "type": "text",
                        "label": "Color",
                        "default": "marengo"
                    },

                    {
                        "name": "backup",
                        "type": "group",
                        "label": "Backup",
                        "fields": [
                            {
                                "name": "where",
                                "type": "select",
                                "label": "Where",
                                "default": "here",
                                "options": [
                                    {"value": "here", "label": "Here"},
                                    {"value": "there", "label": "There"}
                                ]
                            },
                            {
                                "name": "when",
                                "type": "text",
                                "label": "When"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "data" : {
        "first_name": "Ugon",
