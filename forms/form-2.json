{
    "def" : {
        "title": "Logic",
        "remoteSubmit" : true,
        "buttons" : [
            {
                "text" : "Save",
                "classes" : ["button", "button-primary","button-large"],
                "type" : "submit",
                "action": "submit"
            },
            {
                "text" : "Cancel",
                "classes" : ["button", "button-primary","button-large"],
                "type" : "button"
            }

        ],
        "fields" : [

            {
                "type" : "checkbox",
                "name" : "hobbies",
                "label" : "Hobbies( click 'Other')",
                "classes": ["horizontal", "col-12"],
                "options": [
                    {"value":"reading", "label":"Reading"},
                    {"value":"cooking", "label": "Cooking"},
                    {"value":"kayaking", "label": "Kayaking"},
                    {"value":"other", "label": "Other"}
                ],
                "breakAfter": true
            },
            {
                "type": "text",
                "name": "other",
                "label": "other",
                "classes": ["col-12"],
                "breakAfter": true,
                "cLogic": [
                    {
                        "path": "hobbies",
                        "value": "other",
                        "compare": "in",
                        "relation": "or"
                    }
                ]
            },
            {
                "type": "text",
                "name": "text1",
                "label": "Text1 (show me when 'When' is 'noon'  and 'Where' is 'inside')",
                "classes": ["col-12"],
                "breakAfter": true,
                "cLogic": [
                    {
                        "path": "group0--group1--when",
                        "value": "noon",
                        "compare": "==",
                        "relation": "or"
                    },
                    {
                        "path": "group0--group1--where",
                        "value": "inside",
                        "compare": "==",
                        "relation": "and"
                    }

                ]
            },
            {
                "type": "text",
                "name": "text2",
                "label": "Text2",
                "classes": ["col-3"],
                "default": "world"
            },
            {
                "type": "text",
                "name": "text3",
                "label": "Text3 (show me when Text2 is 'world')",
                "classes": ["col-9"],
                "cLogic": [
                    {
                        "path": "text2",
                        "value": "world",
                        "compare": "==",
                        "relation": "or"
                    }
                ]
            },
            {
                "type": "group",
                "name": "group0",
                "label": "Group0",
                "fields": [
                    {
                        "type": "group",
                        "name" : "group1",
                        "label": "Group1",
                        "fields": [
                            {
                                "type": "select",
                                "name": "when",
                                "label": "When",
                                "default": "noon",
                                "options" : [
                                    {"value":"morning" , "label": "Morning"},
                                    {"value":"noon" , "label": "Noon"},
                                    {"value":"evening" , "label": "Evening"}
                                ],
                                "classes": ["col-9"]
                            },

                            {
                                "type": "radio",
                                "name": "where",
                                "label": "Where",
                                "default": "inside",
                                "options" : [
                                    {"value":"inside" , "label": "Inside"},
                                    {"value":"outside" , "label": "Outside"}
                                ],
                                "classes": ["col-9"]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "data" : {
        "text1" : "hello"
    }
}
